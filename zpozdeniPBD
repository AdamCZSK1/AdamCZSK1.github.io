<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Záznam zpoždění učitelů</title>
    <style>
        body { font-family: sans-serif; max-width: 800px; margin: 2rem auto; padding: 0 1rem; color: #333; }
        .form-group { margin-bottom: 1rem; }
        label { display: block; font-weight: bold; margin-bottom: 0.3rem; }
        input, select { padding: 0.5rem; width: 100%; max-width: 400px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
        button { padding: 0.6rem 1rem; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; }
        .btn-submit { background-color: #0056b3; color: white; }
        .btn-submit:hover { background-color: #004494; }
        .btn-export { background-color: #28a745; color: white; margin-top: 1.5rem; margin-bottom: 1rem; display: none; }
        .btn-export:hover { background-color: #218838; }
        table { width: 100%; border-collapse: collapse; margin-top: 1rem; display: none; }
        th, td { border: 1px solid #ddd; padding: 0.5rem; text-align: left; }
        th { background-color: #f4f4f4; }
    </style>
</head>
<body>

    <h2>Záznam zpoždění učitelů</h2>

    <form id="delayForm">
        <div class="form-group">
            <label for="date">Datum:</label>
            <input type="date" id="date" required>
        </div>

        <div class="form-group">
            <label for="teacher">Učitel:</label>
            <select id="teacher" required>
                <option value="">-- Vyberte učitele ze seznamu --</option>
                <option value="Lucie Auinger">Lucie Auinger</option>
                <option value="Daniela Bártíková">Daniela Bártíková</option>
                <option value="Jan Buček">Jan Buček</option>
                <option value="Pavla Budilová (asistentka)">Pavla Budilová (asistentka)</option>
                <option value="Ondřej Čech">Ondřej Čech</option>
                <option value="Blanka Felegy">Blanka Felegy</option>
                <option value="Alena Honková">Alena Honková</option>
                <option value="Anna Hýbnerová">Anna Hýbnerová</option>
                <option value="Miroslava Chocholová">Miroslava Chocholová</option>
                <option value="Radana Jarošová">Radana Jarošová</option>
                <option value="Jana Jindřichová">Jana Jindřichová</option>
                <option value="Jindřich Korytář">Jindřich Korytář</option>
                <option value="Soňa Krausová">Soňa Krausová</option>
                <option value="Pavlína Lindová">Pavlína Lindová</option>
                <option value="Petr Peleška">Petr Peleška</option>
                <option value="Marcela Peroutková Kubíková">Marcela Peroutková Kubíková</option>
                <option value="Lenka Petrášová">Lenka Petrášová</option>
                <option value="Lukáš Procházka">Lukáš Procházka</option>
                <option value="Ilona Prokopcová">Ilona Prokopcová</option>
                <option value="Martina Prošková">Martina Prošková</option>
                <option value="František Váňa">František Váňa</option>
            </select>
        </div>

        <div class="form-group">
            <label for="subject">Předmět:</label>
            <input type="text" id="subject" placeholder="Např. Matematika, Čeština..." required>
        </div>

        <div class="form-group">
            <label for="lesson">Číslo hodiny (0-9):</label>
            <input type="number" id="lesson" min="0" max="9" required>
        </div>

        <div class="form-group">
            <label for="delay">Zpoždění (v minutách):</label>
            <input type="number" id="delay" min="0" required>
        </div>

        <button type="submit" class="btn-submit">Přidat do seznamu</button>
    </form>

    <button id="exportBtn" class="btn-export" onclick="exportCSV()">Stáhnout tabulku do Excelu (CSV)</button>

    <table id="dataTable">
        <thead>
            <tr>
                <th>Datum</th>
                <th>Učitel</th>
                <th>Předmět</th>
                <th>Hodina</th>
                <th>Zpoždění (min)</th>
            </tr>
        </thead>
        <tbody>
            </tbody>
    </table>

    <script>
        // Nastavení dnešního data jako výchozího
        document.getElementById('date').valueAsDate = new Date();

        // Pole pro ukládání dat
        let records = [];

        document.getElementById('delayForm').addEventListener('submit', function(e) {
            e.preventDefault();

            // Získání hodnot z formuláře
            const date = document.getElementById('date').value;
            const teacher = document.getElementById('teacher').value;
            const subject = document.getElementById('subject').value;
            const lesson = document.getElementById('lesson').value;
            const delay = document.getElementById('delay').value;

            // Uložení do pole
            records.push({ date, teacher, subject, lesson, delay });

            // Přidání řádku do HTML tabulky
            const tbody = document.querySelector('#dataTable tbody');
            const row = document.createElement('tr');
            row.innerHTML = `<td>${date}</td><td>${teacher}</td><td>${subject}</td><td>${lesson}</td><td>${delay}</td>`;
            tbody.appendChild(row);

            // Zobrazení tabulky a tlačítka pro export (byly skryté, dokud nebylo co exportovat)
            document.getElementById('dataTable').style.display = 'table';
            document.getElementById('exportBtn').style.display = 'inline-block';

            // Vyčištění formuláře (datum necháme)
            document.getElementById('teacher').value = '';
            document.getElementById('subject').value = '';
            document.getElementById('lesson').value = '';
            document.getElementById('delay').value = '';
        });

        function exportCSV() {
            // \uFEFF je tzv. BOM (Byte Order Mark) - říká Excelu, že jde o UTF-8 a má správně číst českou diakritiku
            // Používáme středníky, protože český Excel je očekává jako oddělovač buněk
            let csvContent = "\uFEFFDatum;Učitel;Předmět;Hodina;Zpoždění (min)\n";

            records.forEach(r => {
                csvContent += `${r.date};${r.teacher};${r.subject};${r.lesson};${r.delay}\n`;
            });

            // Vytvoření souboru pro stažení
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            
            link.setAttribute("href", url);
            link.setAttribute("download", "zpozdeni_ucitelu.csv");
            link.style.visibility = 'hidden';
            
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>
